{
  "name": "@quasar/quasar-ui-qflashcard",
  "version": "3.0.0-beta.0",
  "description": "QFlashcard - Quasar component",
  "keywords": [
    "flashcard",
    "animation",
    "transition",
    "quasar",
    "quasarframework"
  ],
  "homepage": "https://github.com/quasarframework/quasar-ui-qflashcard",
  "bugs": "https://github.com/quasarframework/quasar-ui-qflashcard/issues",
  "license": "MIT",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quasarframework/quasar-ui-qflashcard.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hawkeye64"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./index.min.css": {
      "default": "./dist/index.min.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./index.rtl.min.css": {
      "default": "./dist/index.rtl.min.css"
    },
    "./index.rtl.css": {
      "default": "./dist/index.rtl.css"
    },
    "./dist/api/QFlashcard.json": {
      "default": "./dist/api/QFlashcard.json"
    },
    "./dist/api/QFlashcardSection.json": {
      "default": "./dist/api/QFlashcardSection.json"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint src build types",
    "dev:umd": "pnpm build && node build/script.open-umd.js",
    "build": "node build/index.js && node build/script.types.js",
    "build:js": "node build/script.javascript.js",
    "build:css": "node build/script.css.js",
    "build:api": "node build/build.api.js && node build/script.types.js",
    "typecheck": "tsc -p test-d/tsconfig.json --noEmit --pretty false",
    "test:types": "pnpm build && pnpm typecheck",
    "release": "pnpm publish --tag beta"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.9",
    "kolorist": "^1.8.0",
    "open": "^10.2.0",
    "postcss": "^8.5.6",
    "quasar": "^2.19.3",
    "quasar-json-api": "2.0.0-alpha.5",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.0",
    "rtlcss": "^4.3.0",
    "sass-embedded": "^1.99.0",
    "table": "^6.9.0",
    "typescript": "~5.9.3",
    "uglify-js": "^3.19.3",
    "vue": "^3.5.34",
    "zlib": "^1.0.5"
  },
  "browserslist": [
    "last 4 Chrome versions",
    "last 4 Firefox versions",
    "last 2 Edge versions",
    "last 4 Safari versions",
    "last 4 Android versions",
    "last 4 ChromeAndroid versions",
    "last 4 FirefoxAndroid versions",
    "last 4 iOS versions"
  ],
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.1.0"
  },
  "vetur": {
    "tags": "dist/vetur/tags.json",
    "attributes": "dist/vetur/attributes.json"
  }
}
